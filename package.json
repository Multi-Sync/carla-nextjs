{
  "name": "@interworky/carla-nextjs",
  "version": "2.3.1",
  "description": "The QA & Clean-Up Crew for Next.js Vibe Coders. Detect hydration errors, dead code, and bugs from Cursor/v0.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "carla-nextjs": "bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "jest --passWithNoTests",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "nextjs",
    "qa",
    "code-quality",
    "vibe-coding",
    "cursor",
    "v0",
    "hydration-errors",
    "dead-code-elimination",
    "duplicate-detection",
    "typescript",
    "carla",
    "interworky"
  ],
  "author": "Interworky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Multi-Sync/carla-nextjs.git"
  },
  "bugs": {
    "url": "https://github.com/Multi-Sync/carla-nextjs/issues"
  },
  "homepage": "https://github.com/Multi-Sync/carla-nextjs#readme",
  "dependencies": {
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/generator": "^7.23.0",
    "@babel/types": "^7.23.0",
    "axios": "^1.7.7",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "execa": "^8.0.0",
    "fast-glob": "^3.3.2",
    "glob": "^10.3.10",
    "inquirer": "^9.2.0",
    "linkinator": "^6.0.0",
    "object-hash": "^3.0.0",
    "ora": "^5.4.1",
    "prompts": "^2.4.2",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.0",
    "@types/babel__traverse": "^7.20.0",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.10.0",
    "@types/object-hash": "^3.0.0",
    "@types/ora": "^3.2.0",
    "@types/prompts": "^2.4.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ]
}
